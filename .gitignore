### ===== 安全 & 构建产物（上传 GitHub 前必排除）=====
# 构建产物
target/
build/
dist/
*.class
*.jar
*.war

# 密钥 / 环境变量（含真实凭证，绝对不能进仓库）
*.env
*.env.*
.env

# WorkBuddy 内部记忆（含项目密钥片段，勿提交）
.workbuddy/

# 运行时数据
ai-companion/data/

# 含密钥片段的安全审查报告
security-audit*.md

# Spring 配置：真实 application.yml 含环境变量注入的密钥，必须排除；
# 仅提交安全的 application.yml.template（纯 ${ENV_VAR} 占位，无明文）供克隆后复制使用。
application.yml
application-*.yml
# 例外：安全的模板文件要进仓库
!application.yml.template

# 其他 IDE / AI 助手目录
.idea/
.trae/
.zcode/
.freebuff/
*.iml
*.ipr
*.iws

# 运行日志
*.log

# 备份文件 & 工具缓存
*.bak
luyao-ai-intro/.cache/
