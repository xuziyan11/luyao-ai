<Slide style={{ width:'1280px', height:'720px', background:'#0B0D12', padding:'20px 60px', fontFamily:"'PingFang SC','Inter',sans-serif", position:'relative' }}>
  <Box style={{ height:100, justifyContent:'center' }}>
    <Text style={{ fontSize:34, fontWeight:'bold', color:'#EDEFF5' }}>技术栈总览</Text>
  </Box>
  <Box style={{ height:500, flexDirection:'row', gap:36 }}>
    <Box style={{ width:300, justifyContent:'center' }}>
      <Text style={{ fontSize:18, color:'rgba(237,239,245,0.55)', letterSpacing:3 }}>STACK</Text>
      <Box style={{ width:64, height:4, borderRadius:2, background:'linear-gradient(135deg,#FF6F5E 0%,#FFAE6B 100%)', marginTop:16 }} />
      <Text style={{ fontSize:16, color:'rgba(237,239,245,0.5)', marginTop:20, lineHeight:1.7 }}>单 JVM 全栈，云原生组件即插即用。</Text>
    </Box>
    <Box style={{ flex:1, flexDirection:'column', gap:16, justifyContent:'center' }}>
      <Box style={{ flexDirection:'row', gap:18, alignItems:'center', background:'rgba(255,255,255,0.05)', borderRadius:12, padding:'16px 20px' }}>
        <FAIcon name='server' style={{ fill:'#FF6F5E', width:32, height:32 }} />
        <Box><Text style={{ fontSize:20, fontWeight:'bold', color:'#EDEFF5' }}>后端 · Spring Boot 3 + Java 21</Text><Text style={{ fontSize:15, color:'rgba(237,239,245,0.65)' }}>单 JVM 同时承载主站 8083 与后台 8084</Text></Box>
      </Box>
      <Box style={{ flexDirection:'row', gap:18, alignItems:'center', background:'rgba(255,255,255,0.05)', borderRadius:12, padding:'16px 20px' }}>
        <FAIcon name='database' style={{ fill:'#FF6F5E', width:32, height:32 }} />
        <Box><Text style={{ fontSize:20, fontWeight:'bold', color:'#EDEFF5' }}>存储 · MySQL</Text><Text style={{ fontSize:15, color:'rgba(237,239,245,0.65)' }}>每账号独立物理表，聊天/记忆/好感度隔离</Text></Box>
      </Box>
      <Box style={{ flexDirection:'row', gap:18, alignItems:'center', background:'rgba(255,255,255,0.05)', borderRadius:12, padding:'16px 20px' }}>
        <FAIcon name='robot' style={{ fill:'#FF6F5E', width:32, height:32 }} />
        <Box><Text style={{ fontSize:20, fontWeight:'bold', color:'#EDEFF5' }}>AI · DeepSeek + 火山 + 豆包</Text><Text style={{ fontSize:15, color:'rgba(237,239,245,0.65)' }}>LLM 对话 / TTS·ASR / 端到端实时语音</Text></Box>
      </Box>
      <Box style={{ flexDirection:'row', gap:18, alignItems:'center', background:'rgba(255,255,255,0.05)', borderRadius:12, padding:'16px 20px' }}>
        <FAIcon name='comment' style={{ fill:'#FF6F5E', width:32, height:32 }} />
        <Box><Text style={{ fontSize:20, fontWeight:'bold', color:'#EDEFF5' }}>前端 · 多屏 SPA</Text><Text style={{ fontSize:15, color:'rgba(237,239,245,0.65)' }}>深色主题聊天 / 记忆 / 我的 / 日记四屏</Text></Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ height:60, flexDirection:'row', justifyContent:'space-between', alignItems:'center' }}>
    <Text style={{ fontSize:14, color:'rgba(237,239,245,0.5)' }}>路瑶AI · 项目介绍</Text>
